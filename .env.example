# ── Postgres ───────────────────────────────────────────────────────────
# Supabase project DropHunter_DB (ref tfupzscaeibhvflgomxz, ap-southeast-1).
#
# Use a POOLER host, not db.<ref>.supabase.co: the direct host is IPv6-only,
# and GitHub-hosted runners have no IPv6, so the cron sweep cannot reach it.
# Session pooler (port 5432) is the right pairing for the client-side pool
# this app keeps; transaction pooler (6543) also works.
DATABASE_URI=postgresql://postgres.tfupzscaeibhvflgomxz:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Client-side connection pool. The database is in another region now, so a
# fresh connection per query costs a TLS handshake each time.
DB_POOL_MIN=1
DB_POOL_MAX=8
DB_CONNECT_TIMEOUT=10
DB_APP_NAME=pitstop

# Telegram bot (from @BotFather)
TELEGRAM_BOT_TOKEN=
# Your Telegram chat ID (from @userinfobot) — used by cron alerts
TELEGRAM_CHAT_ID=

# Discord bot (optional)
DISCORD_BOT_TOKEN=
# Discord channel ID for cron alerts (optional)
DISCORD_CHANNEL_ID=

# Groq API key (https://console.groq.com)
GROQ_API_KEY=
# AI provider: groq (only option for now)
AI_PROVIDER=groq

# Cron reminder delivery
CRON_NOTIFY_PLATFORM=telegram
CRON_NOTIFY_CHAT_ID=   # leave blank to use TELEGRAM_CHAT_ID

# ── Web front end (web/) ───────────────────────────────────────────────
# dev    — the sign-in button signs you in as DEV_USER, no IdP, treated as an
#          approved admin. Local development only.
# google — Google sign-in. Anyone with a Google account can sign in; an admin
#          must approve them before any fleet data is visible.
AUTH_MODE=dev
DEV_USER=thomas
DEV_USER_NAME=Thomas V

# Required whenever AUTH_MODE is not "dev"
# generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
SESSION_SECRET=
SESSION_HTTPS_ONLY=1
SESSION_MAX_AGE=43200

# Google OAuth client (console.cloud.google.com → APIs & Services →
# Credentials → OAuth client ID → Web application).
# Authorised redirect URI: https://<your-host>/auth/callback
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Defaults below are correct for Google; override only for another provider.
OIDC_ISSUER=https://accounts.google.com
OIDC_SCOPES=openid email profile
OIDC_PROVIDER_NAME=Google

# The owner. This address is approved as an admin on its first sign-in —
# otherwise nobody could approve the first account. Everyone else lands
# unapproved and sees nothing until you approve them at /admin/users.
ADMIN_EMAIL=

# A document this many days out or nearer counts as "due soon"
WEB_SOON_DAYS=30

# ── Email digest (Resend) ──────────────────────────────────────────────
# One email per sweep summarising every reminder that fired — not one per
# document. Skipped entirely when RESEND_API_KEY is unset.
RESEND_API_KEY=
EMAIL_FROM=PitStop <aiassistant@thomasjvarghese.com>
EMAIL_TO=thomasjvarghese49@gmail.com
# Set to 0 to keep the key configured but stop sending.
ENABLE_EMAIL=1
# Which of the sweep's nine offsets earn an email. Discord gets all of them;
# email would otherwise arrive nine times for one document nobody renews.
# Default: a week before, and the day before. Add 7 for one nudge after it
# lapses — with the default, a lapsed document stops emailing at -1.
EMAIL_OFFSETS=-7,-1
